# Projeto Supabase do Diário da Hellen.
# Encontre esses valores em: Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://pojqwgiwecmtwdopcmfa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public

# Chave SECRETA (service role / secret key) — NUNCA prefixe com
# NEXT_PUBLIC_, nunca comite o valor real, nunca use em componente
# "use client". Só é usada nas rotas de servidor do Cantinho da Helô
# (src/app/api/cantinho/*), pra deixar a Helô salvar um desenho sem
# precisar de login. Sem essa variável, o resto do app funciona
# normalmente — só o Cantinho da Helô que não vai funcionar.
SUPABASE_SECRET_KEY=cole-aqui-a-chave-secreta
